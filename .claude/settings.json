{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(uv run *)", "Bash(uv sync)", "Bash(git status)", "Bash(git diff *)", "Bash(git log *)",
              "Bash(git branch *)", "Bash(gh pr checks *)"],
    "deny": ["Read(./.env)", "Read(./.env.local)",
             "Bash(git push --force *)", "Bash(git push -f *)",
             "Bash(git push origin main*)", "Bash(git push origin HEAD:main*)",
             "Bash(gh pr merge --admin *)", "Bash(gh pr merge --squash *)"]
  },
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-tests.sh" } ] }
    ]
  }
}
