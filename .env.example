# Zetaris REST
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=replace-me
# Admin, setup only, never used at runtime (the app refuses to run on it).
ZETARIS_ADMIN_API_KEY=
# Role keys used by the app: create them as described in docs/zetaris-setup.md.
# svc_buyer (role buyer); svc_risk (role risk_manager, also used for director).
ZETARIS_KEY_BUYER=
ZETARIS_KEY_RISK=
ZETARIS_USER_AGENT="supplier-risk your.email@example.com"

# Meterless Nightshift (Console -> Connect). The NVIDIA key stays in Nightshift.
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=replace-me
METERLESS_APP_ID=supplier-risk
METERLESS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
METERLESS_DEEP_MODEL=replace-me-ultra-model-id
METERLESS_FAST_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Local databases
ERP_DB_PASSWORD=
ERP_READER_PASSWORD=
ERP_DATABASE_URL=postgresql://erp:replace-me@localhost:5433/erp
APP_DATABASE_URL=postgresql://app:replace-me@localhost:5434/app

# Application
APP_ENV=prod

# Application logging
LOG_LEVEL=INFO
LOG_DIR=logs

METERLESS_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b

# Meterless engines (World Model + H-MEM)
CONTEXT_SERVICE_URL=http://localhost:7070
# Shared secret for the X-Internal-Token header (min. 32 visible characters), e.g. openssl rand -hex 32.
CONTEXT_SERVICE_TOKEN=
CONTEXT_SERVICE_TIMEOUT_SECONDS=5

# Zetaris view snapshots (backend/app/tools/cache.py) and the tool-result cache.
# ERP views: TTL and the oldest snapshot served while a refresh runs.
TOOL_CACHE_TTL_SECONDS=900
TOOL_CACHE_MAX_STALE_SECONDS=3600
# SEC (v_supplier_revenue) and Eurostat (v_country_indicators) views read live REST sources.
TOOL_CACHE_EXTERNAL_TTL_SECONDS=21600
TOOL_CACHE_EXTERNAL_MAX_STALE_SECONDS=86400
# Background snapshot loads: Zetaris timeout per load and at most N loads at once.
ZETARIS_SNAPSHOT_TIMEOUT_SECONDS=300
SNAPSHOT_MAX_CONCURRENCY=2
